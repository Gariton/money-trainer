# Shared API token used by the iPhone developer app.
API_TOKEN=change-me-for-local-development

# Host ports for the default lightweight API and opt-in inference API.
API_PORT=8000
API_ML_PORT=8001

# Upload limit enforced while streaming each image.
MAX_UPLOAD_BYTES=20971520

# Each Training Job explicitly selects Mock Mode; this controls worker polling only.
WORKER_POLL_SECONDS=2

# Change these together if the database is exposed beyond the Compose network.
POSTGRES_USER=money_trainer
POSTGRES_PASSWORD=money_trainer
POSTGRES_DB=money_trainer
